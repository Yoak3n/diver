{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@cos/*": ["../../harness/packages/*/src/index.ts"],
      "cordis": ["../../harness/node_modules/cordis"],
      "@diver/memory": ["../memory/src/index.ts"],
      "@diver/backend": ["../backend/src/index.ts"],
      "@diver/basic-tools": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "../../harness/packages/**/*.ts"]
}
