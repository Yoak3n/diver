{
  "name": "@diver/companion",
  "version": "0.1.0",
  "private": true,
  "description": "Diver companion bundle: patch layer over dsh-base (persona, tool policy) + companion services (web transport, presence, memory, providers)",
  "type": "module",
  "main": "lib/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./lib/index.ts",
    "./web": "./lib/web.ts",
    "./presence": "./lib/presence.ts",
    "./memory": "./lib/memory/index.ts",
    "./compaction": "./lib/compaction.ts",
    "./llm-opencode": "./lib/llm-opencode/index.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
