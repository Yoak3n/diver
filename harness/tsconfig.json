{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@cos/*": ["./packages/*/src/index.ts"],
      "cordis": ["./node_modules/cordis"]
    }
  },
  "include": ["main.ts", "scripts/**/*.ts", "packages/**/*.ts"]
}
