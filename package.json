{
  "name": "tauri-vue-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "pet:fetch": "node scripts/pet-fetch.mjs",
    "pet:models": "node scripts/pet-models.mjs",
    "pet:models:yui": "node scripts/pet-models.mjs --yui",
    "bundle:release": "node scripts/bundle-release.mjs",
    "start:companion": "pnpm --dir harness exec tsx --expose-internals ../cos-plugins/companion/src/companion.ts --profile companion --plugin-root ../cos-plugins --bundles ../cos-plugins/bundle-companion --harness .",
    "typecheck": "pnpm run typecheck:harness && pnpm run typecheck:plugins",
    "typecheck:harness": "pnpm --dir harness typecheck",
    "typecheck:plugins": "pnpm -r --filter \"./cos-plugins/*\" --filter \"!./cos-plugins/bundle-companion\" typecheck"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.15",
    "live2dcubismcore": "^1.0.2",
    "markdown-it": "^15.0.2",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^7.4.3",
    "vue": "^3.5.13",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
